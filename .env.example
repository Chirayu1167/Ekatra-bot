# Copy to .env and fill in real values. Never commit .env.
# Required in production: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM,
# PUBLIC_BASE_URL, DATABASE_URL, and OPTOUT_HASH_SECRET. Set ADMIN_API_KEY only to bootstrap
# the first platform administrator. CERTIFICATE_SECRET is strongly recommended. Startup fails
# fast naming missing required variables (never their values). See src/config/env.ts.
# Optional (have safe defaults): PORT, NODE_ENV, TWILIO_WEBHOOK_VALIDATE, DATABASE_* (pool),
# MEDIA_DIR, all TWILIO_CONTENT_SID_*, all LLM_*, CORS_ORIGINS, RATE_LIMIT_* and retention days.

# Optional. Default 3000.
PORT=3000

# Optional. Default development. Set to production on staging/prod: the server then refuses
# to start with TWILIO_WEBHOOK_VALIDATE=false (unverified public webhook).
NODE_ENV=development
# Optional. Default false. Production API/worker never migrate at startup unless explicitly
# opted in; normally run the one-shot `npm run migrate` job before rollout.
RUN_MIGRATIONS_ON_START=false

# Get these from https://www.twilio.com/console. All three required in production.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional. Default true. Set to false only for local curl experiments. Never in production.
TWILIO_WEBHOOK_VALIDATE=true

# Required in production. Public base URL Twilio calls, e.g. https://abc.ngrok-free.app
# (no trailing slash). Required when TWILIO_WEBHOOK_VALIDATE=true so signature validation
# uses the exact public URL.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# --- PostgreSQL (system of record, Phase 2.5) ---------------------------------------------
# Required everywhere except tests (which provision their own databases).
# Example: postgres://ekatra:secret@db-host:5432/ekatra. Never log or print this value.
# Staging/production hosted databases: set DATABASE_SSL=require.
# Optional direct/session connection used by `npm run migrate`. It must not point at a
# transaction-pooling proxy because migrations hold a PostgreSQL session advisory lock.
# Keep it in the deployment secret store, separate from the restricted app DATABASE_URL.
MIGRATION_DATABASE_URL=
DATABASE_URL=postgres://ekatra:changeme@localhost:5432/ekatra

# Optional. Default 10. Application pool size (single instance; raise with load).
DATABASE_POOL_MAX=10

# Optional. Default off. Set to require for any hosted database (staging/production).
DATABASE_SSL=off

# Optional. Defaults 10000 / 30000 ms. Query watchdog and idle-client reaping.
# Migrations and the import script disable the statement timeout for their own transactions.
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# --- Course delivery -------------------------------------------------------------------
# Required in production. Enables the /admin API (send "Authorization: Bearer <key>").
# At least 16 characters. Leave unset to keep the admin API switched off (local dev only).
# Generate one with: openssl rand -hex 24
# This key is the bootstrap platform_admin: use it to create the first organisation and
# users (POST /admin/orgs, POST /admin/users), then prefer per-user keys. See
# docs/authz-policy.md.
ADMIN_API_KEY=

# Optional. Default ./media. Files in this folder are served PUBLICLY at
# ${PUBLIC_BASE_URL}/media/<file> so Twilio can fetch lesson attachments.
# Keep file names short (<= 20 chars, ASCII). Never put secrets here.
MEDIA_DIR=./media

# --- Tap buttons (optional) ------------------------------------------------------------
# Run `npm run buttons:setup` once. It creates the quick-reply templates in your Twilio
# account and prints these lines. Leave them empty to keep typed commands only.
TWILIO_CONTENT_SID_MAIN_MENU=
TWILIO_CONTENT_SID_NAV=
TWILIO_CONTENT_SID_RESUME=
TWILIO_CONTENT_SID_START_COURSE=
TWILIO_CONTENT_SID_COURSES=
TWILIO_CONTENT_SID_CMDS_1=
TWILIO_CONTENT_SID_CMDS_2=
TWILIO_CONTENT_SID_QUIZ=

# Sent right after web registration ("tap Start Course"). `npm run buttons:setup` creates it and
# submits it to WhatsApp for approval; outside the 24 h window it only works once APPROVED.
# Until then (or in the Twilio sandbox, after the learner sends "join <code>") the welcome goes
# out as a plain message.
TWILIO_CONTENT_SID_WELCOME=

# Approved quick-reply template sent when a scheduled lesson lands outside the 24-hour window
# (see docs/scheduling.md). Its button payload maps to NEXT, which delivers the pending lesson.
# Optional: unset means closed-window scheduled lessons fail visibly instead of dead-lettering.
TWILIO_CONTENT_SID_SCHEDULE=

# Hard request timeout for every Twilio API call (ms), in addition to the Promise.race backstop.
TWILIO_REQUEST_TIMEOUT_MS=10000

# Required in production (min 32 chars). Keyed HMAC for opt-out phone hashes. Losing or
# changing this secret silently re-enables messaging to opted-out numbers: back it up.
# In dev/test a default plain SHA-256 is used; leaving it unset in production refuses startup.
OPTOUT_HASH_SECRET=

# Recommended in production (min 16 chars). Signs certificate links so they can't be guessed.
# If unset, a value is derived from TWILIO_AUTH_TOKEN; a stable independent secret is preferable.
# Changing it invalidates links already sent to learners.
CERTIFICATE_SECRET=

# Optional. Default 10. Certificate resend cooldown in minutes: a second resend of the same
# certificate within this window returns 409 and sends nothing. One idempotency key per
# certificate makes a rapid double call send exactly once.
CERT_RESEND_COOLDOWN_MINUTES=10

# --- Access control, ingress, retention (Phase 2) ----------------------------------------
# Optional. Comma-separated browser origins allowed for cross-origin calls.
# Default: unset = no CORS headers at all.
CORS_ORIGINS=

# Optional. Default 100. Failed admin/webhook auth attempts allowed per IP per hour
# before 429s (bounds credential probing; valid callers never trip it).
RATE_LIMIT_AUTH_FAILURES_PER_HOUR=100

# Optional. Default 30. Days webhook de-duplication ids are kept (pruned at startup and by
# `npm run cleanup`). Opt-outs, enrollments and completion records are never pruned.
PROCESSED_MESSAGE_RETENTION_DAYS=30

# Optional. Default 365. Days audit-log rows are kept. Pruned only by `npm run cleanup`.
AUDIT_LOG_RETENTION_DAYS=365

# --- Learner-data retention (durable delivery, pruned only by `npm run cleanup`) ---------
# Optional. Default 90. Completed/failed jobs older than this are pruned.
JOB_RETENTION_DAYS=90
# Optional. Default 90. Send-attempt rows older than this are pruned.
ATTEMPT_RETENTION_DAYS=90
# Optional. Default 90. Completed/failed inbound webhook events older than this are pruned.
INBOUND_EVENT_RETENTION_DAYS=90
# Optional. Default 90. Completed/discarded dead letters older than this are pruned.
DEAD_LETTER_RETENTION_DAYS=90

# --- Phase 3 durable delivery (worker, retry, scheduling) -------------------------------
# Optional. Default 2000. How often the worker polls for due jobs, in ms.
WORKER_POLL_MS=2000

# Optional. Default 300. Crash-recovery horizon, in seconds: work stuck in
# 'processing' longer than this is reclaimed by another worker.
WORKER_VISIBILITY_SECS=300

# Optional. Default 4. Upper bound on jobs processed per worker poll tick. Must satisfy
# WORKER_MAX_JOBS_PER_TICK * 2 + 2 <= DATABASE_POOL_MAX (two connections per job plus the
# scheduler leader lock and the heartbeat writer), or startup refuses.
WORKER_MAX_JOBS_PER_TICK=4

# Optional. Default true. The scheduler loop runs inside the worker; only one
# worker leads a tick at a time (advisory lock), the rest skip.
SCHEDULER_ENABLED=true

# Optional. Default 60000. Maximum worker-heartbeat age shown by /worker-status, in ms.
READINESS_HEARTBEAT_MAX_AGE_MS=60000

# Optional. Default 60000. Scheduler tick cadence, in ms.
SCHEDULER_TICK_MS=60000

# Optional. Default 6. Fallback catch-up grace in hours when an org has none
# configured: slots older than this are consumed without sending; at most one
# missed lesson per enrollment per tick is ever sent.
SCHEDULER_GRACE_HOURS=6

# --- Local LLM (Ollama, optional) --------------------------------------------------------
# Answers learner questions about THEIR OWN course only (never other topics). On timeout/error the
# learner gets a fixed message and the course carries on; lessons never depend on the LLM.
# The container starts and lessons work when Ollama is absent. All have defaults.
LLM_MODEL=qwen2.5:1.5b-instruct-q4_k_m
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_MS=10000
LLM_MAX_TOKENS=250
LLM_TEMPERATURE=0.2
# Optional. Default 20. Course questions each learner may ask per hour (bounds cost and abuse).
LLM_QUESTIONS_PER_HOUR=20
