PORT=3000

# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to false only for local curl experiments. Never in production.
TWILIO_WEBHOOK_VALIDATE=true

# Public base URL Twilio calls, e.g. https://abc.ngrok-free.app (no trailing slash)
# Required when TWILIO_WEBHOOK_VALIDATE=true so signature validation uses the exact public URL.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
