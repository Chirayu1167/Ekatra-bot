{
  "name": "whatsapp-chatbot",
  "version": "0.1.0",
  "description": "Twilio WhatsApp chatbot — course delivery MVP for Ekatra",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.16.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "check:admin-ui-deps": "node scripts/check-admin-ui-deps.cjs",
    "prebuild": "npm run check:admin-ui-deps",
    "build": "tsc -p tsconfig.build.json && npm run build --prefix admin-ui",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "test": "vitest run",
    "ci:all": "npm run typecheck:all && npm run lint:all && npm run test:all && npm run build",
    "typecheck:all": "npm run check:admin-ui-deps && npm run typecheck && npm run typecheck --prefix admin-ui",
    "lint:all": "npm run check:admin-ui-deps && npm run lint && npm run lint --prefix admin-ui",
    "test:all": "npm run check:admin-ui-deps && npm test && npm test --prefix admin-ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "cleanup": "tsx src/scripts/cleanup.ts",
    "cleanup:prod": "node dist/scripts/cleanup.js",
    "import:sqlite": "tsx src/scripts/import-sqlite.ts",
    "import:sqlite:prod": "node dist/scripts/import-sqlite.js",
    "staging:smoke": "tsx scripts/staging-smoke.ts",
    "buttons:setup": "tsx src/scripts/buttons-setup.ts",
    "buttons:setup:prod": "node dist/scripts/buttons-setup.js"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "twilio": "^6.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
